<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skylanders Quiz</title>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #1a0826;
            color: white;
            overflow-x: hidden;
        }
        .container {
            width: 100%;
            height: 100vh;
            height: 100dvh;
            margin: 0;
            padding: 24px;
            box-sizing: border-box;
            background: #0097d5;
            transition: background-color 1.8s linear;
            border-radius: 0;
            box-shadow: none;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        #homeScreen, #elementsScreen {
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            min-height: 0;
            gap: 28px;
        }
        #homeScreen.hidden, #elementsScreen.hidden {
            display: none;
        }
        #quizScreen:not(.hidden) {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
        }
        .quiz-topbar {
            display: flex;
            align-items: baseline;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
        }
        .quiz-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin: 8px 0;
        }
        .quiz-controls input[type="text"] {
            flex: 1 1 260px;
            max-width: 420px;
            margin-bottom: 0;
            padding: 8px;
            font-size: 16px;
        }
        .quiz-controls .input-wrap {
            position: relative;
            display: flex;
            flex: 1 1 260px;
            max-width: 420px;
        }
        .quiz-controls .input-wrap input[type="text"] { flex: 1 1 auto; max-width: none; }
        #shuffleGhost {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            opacity: 0.5;
            pointer-events: none;
            font-weight: bold;
            font-size: 16px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #112e3e;
        }
        #shuffleGhost.hidden { display: none; }
        .quiz-controls #typeShuffleBtn {
            padding: 8px 15px;
            border-radius: 5px;
            border: 3px solid #112e3e;
            background: #a58bd6;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }
        .quiz-controls #typeShuffleBtn.on {
            border-color: white;
            box-shadow: 0 0 10px rgba(255,255,255,.8);
        }
        .quiz-controls #typeShuffleBtn:disabled { opacity: .5; cursor: default; }
        #typeToast {
            position: fixed;
            left: 50%;
            bottom: 90px;
            transform: translateX(-50%);
            background: rgba(4, 18, 30, 0.9);
            border: 2px solid #71cbd6;
            color: #fff;
            font-size: 14px;
            font-weight: bold;
            padding: 8px 14px;
            border-radius: 8px;
            z-index: 9998;
            transition: opacity .25s ease;
        }
        #typeToast.hidden { display: none; }
        .quiz-controls #giveUpBtn {
            padding: 8px 15px;
            border-radius: 5px;
            border: 3px solid #112e3e;
            background: #71cbd6;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }
        .quiz-controls #pauseBtn {
            padding: 8px 15px;
            border-radius: 5px;
            border: 3px solid #112e3e;
            background: #f5c542;
            color: #112e3e;
            font-weight: bold;
            cursor: pointer;
        }
        .quiz-controls #pauseBtn:disabled { opacity: .5; cursor: default; }
        #pauseOverlay {
            position: fixed;
            inset: 0;
            background: rgba(4, 18, 30, 0.88);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 999;
        }
        #pauseOverlay.hidden { display: none; }
        .pause-box {
            background: #0e2a3b;
            border: 4px solid #71cbd6;
            border-radius: 14px;
            padding: 32px 40px;
            text-align: center;
            color: #fff;
            box-shadow: 0 0 40px rgba(113, 203, 214, .5);
        }
        .pause-box h2 { margin: 0 0 8px; font-size: 40px; }
        .pause-box p { margin: 0 0 20px; opacity: .85; }
        .pause-box button {
            display: block;
            width: 260px;
            margin: 10px auto;
            padding: 12px 15px;
            border-radius: 8px;
            border: 3px solid #112e3e;
            background: #71cbd6;
            color: #fff;
            font-weight: bold;
            font-size: 17px;
            cursor: pointer;
        }
        .pause-box button:hover { filter: brightness(1.1); }
        .quiz-controls .toggle-container { margin: 0; }
        .quiz-controls #restartBtn,
        .quiz-controls #backHomeBtn { margin-top: 0; }
        
        .filter-buttons {
            margin-bottom: 0;
            width: 100%;
            max-width: 1100px;
        }
        .btn-row {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 18px;
        }
        .btn-row .filter-btn {
            flex: 1 1 220px;
            max-width: 280px;
            padding: 16px 0;
            box-sizing: border-box;
        }
        .home-hero h1 {
            margin: 0;
            font-size: 72px;
            text-shadow: 0 0 18px rgba(0,0,0,0.45);
        }
        #elementsScreen h1 {
            margin: 0;
            font-size: 64px;
            text-shadow: 0 0 18px rgba(0,0,0,0.45);
        }
        #startBtn, #startElementBtn {
            padding: 18px 36px;
            font-size: 24px;
            border-radius: 8px;
            border: 3px solid #112e3e;
            background: #dec306;
            color: #112e3e;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s ease, filter 0.2s ease;
        }
        #startBtn:hover, #startElementBtn:hover {
            transform: scale(1.05);
            filter: brightness(1.1);
        }
        #backHomeBtn, #elementsBackBtn {
            background-color: #dec306;
            color: #112e3e;
            border: 3px solid #112e3e;
            padding: 14px 26px;
            margin-top: 0;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 18px;
            transition: transform 0.2s ease, filter 0.2s ease;
        }
        #backHomeBtn:hover, #elementsBackBtn:hover { transform: scale(1.05); filter: brightness(1.1); }
        #restartBtn {
            background-color: #71cbd6;
            color: white;
            border: 3px solid #112e3e;
            padding: 8px 15px;
            margin-top: 0;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
        #restartBtn:hover { filter: brightness(1.1); }
        #quizTitle {
            font-size: 26px;
            margin: 0;
            color: white;
            text-shadow: 0 0 8px rgba(0,0,0,0.5);
        }
        .element-btn {
            color: white;
            border: 3px solid #112e3e;
            padding: 18px 15px;
            margin: 0;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 20px;
            flex: 1 1 220px;
            max-width: 280px;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }
        .element-btn:hover { filter: brightness(1.15); transform: scale(1.04); }
        
        .element-btn.active {
            border-color: white !important;
            transform: scale(1.06);
            animation: portalGlow 1.5s infinite;
        }
        
        .element-btn.active.playing {
            transform: none;
            animation: none;
            box-shadow: none;
            border-color: #dec306 !important;
        }
        .el-earth { background-color: #b1701f; border-color: #975907; }
        .el-air   { background-color: #3fbaf7; border-color: #25a0f2; }
        .el-fire  { background-color: #e61a1d; border-color: #cc0101; }
        .el-water { background-color: #1b4c8d; border-color: #023576; }
        .el-magic { background-color: #6f418a; border-color: #592972; }
        .el-tech  { background-color: #f5812b; border-color: #e66b15; }
        .el-life  { background-color: #18b125; border-color: #01980c; }
        .el-undead{ background-color: #65636f; border-color: #4e4c58; }
        .el-light { background-color: #fce14f; border-color: #fac936; }
        .el-dark  { background-color: #243d5c; border-color: #0d2345; }
        .el-kaos  { background-color: #493e71; border-color: #31275a; }
        .filter-btn {
            background-color: #71cbd6;
            color: white;
            border: 3px solid #112e3e;
            padding: 16px 15px;
            margin: 0;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 18px;
            transition: all 0.3s ease;
        }
      
        .filter-btn.active {
            background-color: #58b9ca;
            border-color: white;
            color: white;
            transform: scale(1.05);
            animation: portalGlow 1.5s infinite;
        }

      
        .filter-btn.active.playing {
            transform: none;
            animation: none;
            box-shadow: none;
            border-color: #dec306;
        }
        @keyframes portalGlow {
            0% { box-shadow: 0 0 5px white, 0 0 10px white; }
            50% { box-shadow: 0 0 10px white, 0 0 25px white, 0 0 45px rgba(255,255,255,0.9); }
            100% { box-shadow: 0 0 5px white, 0 0 10px white; }
        }
        input {
            padding: 10px;
            font-size: 18px;
            width: 80%;
            border-radius: 5px;
            border: none;
            margin-bottom: 20px;
        }
        .stats {
            font-size: 18px;
            margin: 0;
        }
       
        .found-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(var(--card-size, 50px), 100%), var(--card-size, 50px)));
            justify-content: center;
            gap: var(--card-gap, 6px);
            margin-top: 6px;
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            align-content: start;
            padding: 6px;
            background: rgba(0,0,0,0.18);
            border-radius: 8px;
        }
        .skylander-card {
            perspective: 500px;
            aspect-ratio: 3 / 4;
            width: 100%;
        }
        .card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transition: transform 0.5s ease;
        }
        .skylander-card.flipped .card-inner { transform: rotateY(180deg); }
        .card-face {
            position: absolute;
            inset: 0;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 2px;
            box-sizing: border-box;
        }
        .card-front {
            background: #000;
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            border: 1px solid rgba(255,255,255,0.25);
        }
        .card-back {
            transform: rotateY(180deg);
            background: #2e7d32;
        }
        .skylander-card.missed .card-back { background: #801313; }
        .card-back img {
            width: 100%;
            flex: 1;
            min-height: 0;
            object-fit: contain;
        }
        .card-back span {
            font-size: var(--card-font, 7px);
            line-height: 1.1;
            word-break: break-word;
        }
        .win-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        }

        .win-text {
        font-size: 50px;
        font-weight: bold;
        color: gold;
        text-shadow: 0 0 10px white, 0 0 30px gold;
        animation: winPop 1.2s ease-out forwards;
        }
        
        @keyframes winPop {
        0% {
        transform: scale(0.3);
        opacity: 0;
        }
        60% {
        transform: scale(1.2);
        opacity: 1;
        }
        100% {
        transform: scale(1);
        opacity: 1;
        }
        }

        .hidden {
        display: none;
        }
        #siteFootnote {
            background: #0e2a3b;
            border-top: 3px solid #112e3e;
            padding: 16px 24px 22px;
            font-size: 13px;
            line-height: 1.5;
            color: #dfe9ee;
        }
        #siteFootnote p { margin: 5px 0; }
        #siteFootnote .footnote-small { font-size: 11.5px; opacity: .85; }
        #siteFootnote a { color: #71cbd6; font-weight: bold; }
        .toggle-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 15px 0;
    font-weight: bold;
}

.toggle-label {
    color: white;
    font-size: 14px;
}


.switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 26px;
}


.switch input {
    opacity: 0;
    width: 0;
    height: 0;
}


.slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #444;
    transition: 0.3s;
    border-radius: 34px;
}


.slider:before {
    position: absolute;
    content: "";
    height: 20px;
    width: 20px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
}


input:checked + .slider {
    background-color: #58b9ca;
}

input:checked + .slider:before {
    transform: translateX(24px);
}

        .corner-actions { position: fixed; top: 16px; right: 16px; display: flex; flex-direction: column; gap: 8px; z-index: 50; }
        .corner-actions button { padding: 10px 16px; border-radius: 8px; border: 3px solid #112e3e; background: #f5c542; color: #112e3e; font-weight: bold; font-size: 15px; cursor: pointer; }
        .corner-actions button.alt { background: #71cbd6; color: #fff; }
        .corner-actions button:hover { filter: brightness(1.1); }
        #homeScreen.hidden ~ .corner-actions, body.not-home .corner-actions { display: none; }
        #builderScreen { overflow-y: auto; flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; gap: 18px; }
        #builderScreen.hidden { display: none; }
        #builderTitle { padding: 10px; font-size: 18px; border-radius: 8px; border: 3px solid #112e3e; width: 320px; max-width: 90%; }
        .builder-grid { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px; max-width: 1100px; }
        .builder-card { width: 230px; background: #0e2a3b; border: 3px solid #71cbd6; border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 8px; position: relative; text-align: left; }
        .builder-card label { font-size: 12px; font-weight: bold; opacity: .85; }
        .builder-card input { padding: 7px; border-radius: 6px; border: 2px solid #112e3e; font-size: 14px; }
        .builder-card .preview { height: 70px; display: flex; align-items: center; justify-content: center; }
        .builder-card .preview img { max-height: 70px; max-width: 100%; }
        .builder-card .remove { position: absolute; top: 4px; right: 8px; background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; opacity: .7; }
        .add-circle { width: 64px; height: 64px; border-radius: 50%; border: 3px solid #112e3e; background: #f5c542; color: #112e3e; font-size: 36px; font-weight: bold; cursor: pointer; line-height: 1; }
        .add-circle:hover { filter: brightness(1.1); }
        .builder-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; padding-bottom: 20px; }
        .builder-actions button { padding: 12px 20px; border-radius: 8px; border: 3px solid #112e3e; background: #71cbd6; color: #fff; font-weight: bold; font-size: 16px; cursor: pointer; }
        .builder-actions button.download { background: #f5c542; color: #112e3e; }
        :root { --builder-choice-bg: #0e2a3b; --builder-choice-accent: #71cbd6; --builder-choice-text: #fff; --builder-choice-border: #112e3e; }
        .builder-import { display: flex; flex-direction: column; align-items: center; gap: 12px; width: 100%; }
        .builder-import button { padding: 10px 16px; border-radius: 8px; border: 3px solid var(--builder-choice-border); background: var(--builder-choice-accent); color: var(--builder-choice-text); font-weight: bold; font-size: 15px; cursor: pointer; }
        #builderQuizChoices { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 850px; }
        #builderQuizChoices.hidden { display: none; }
        #builderQuizChoices button { background: var(--builder-choice-bg); border-color: var(--builder-choice-accent); }
    </style>
</head>
<body>

<div class="container">
    <div id="homeScreen" class="home-hero">
        <div class="corner-actions">
            <button onclick="openBuilder()">Build your own quiz</button>
            <button class="alt" onclick="document.getElementById('customQuizInput').click()">Custom quiz</button>
            <input type="file" id="customQuizInput" accept=".json,application/json" style="display:none" onchange="loadCustomQuiz(event)">
        </div>
        <h1>Skylanders Quiz</h1>

        <div class="filter-buttons">
            <div class="btn-row">
                <button class="filter-btn active" onclick="changeGeneration('gll', this)">All Skylanders</button>
            </div>
            <div class="btn-row">
                <button class="filter-btn" onclick="changeGeneration('spyros_adventure', this)">Spyro's Adventure</button>
                <button class="filter-btn" onclick="changeGeneration('giants', this)">Giants</button>
                <button class="filter-btn" onclick="changeGeneration('swap_force', this)">Swap Force</button>
            </div>
            <div class="btn-row">
                <button class="filter-btn" onclick="changeGeneration('trap_team', this)">Trap Team</button>
                <button class="filter-btn" onclick="changeGeneration('superchargers', this)">SuperChargers</button>
                <button class="filter-btn" onclick="changeGeneration('imaginators', this)">Imaginators</button>
            </div>
            <div class="btn-row">
                <button class="filter-btn" onclick="changeGeneration('vehicles', this)">Vehicles</button>
                <button class="filter-btn" onclick="changeGeneration('trap_villain', this)">Trappable Villains</button>
            </div>
 <div class="btn-row">
    <button id="elementsBtn" class="filter-btn" onclick="showElementsScreen()">
        Elements
    </button>
</div>
        </div>

        <button id="startBtn" onclick="startGame()">Start Game</button>
    </div>

    <div id="builderScreen" class="hidden">
        <h1>Build your own quiz</h1>
        <input type="text" id="builderTitle" placeholder="Quiz title" value="My Custom Quiz">
        <div class="builder-import">
            <button id="addQuizBtn" onclick="toggleBuilderQuizChoices()" aria-expanded="false" aria-controls="builderQuizChoices">Add quiz</button>
            <div id="builderQuizChoices" class="hidden" aria-label="Choose a quiz"></div>
            <span id="builderImportStatus" role="status"></span>
        </div>
        <div class="builder-grid" id="builderGrid"></div>
        <div class="builder-actions">
            <button class="download" onclick="downloadCustomQuiz()">Download quiz</button>
            <button onclick="closeBuilder()">Back to Home</button>
        </div>
    </div>

    <div id="elementsScreen" class="hidden">
        <h1>Choose an Element</h1>
        <div class="filter-buttons">
            <div class="btn-row">
                <button class="element-btn el-earth"  onclick="startElementQuiz('earth', this)">Earth</button>
                <button class="element-btn el-air"    onclick="startElementQuiz('air', this)">Air</button>
                <button class="element-btn el-fire"   onclick="startElementQuiz('fire', this)">Fire</button>
            </div>
            <div class="btn-row">
                <button class="element-btn el-water"  onclick="startElementQuiz('water', this)">Water</button>
                <button class="element-btn el-magic"  onclick="startElementQuiz('magic', this)">Magic</button>
                <button class="element-btn el-tech"   onclick="startElementQuiz('tech', this)">Tech</button>
            </div>
            <div class="btn-row">
                <button class="element-btn el-life"   onclick="startElementQuiz('life', this)">Life</button>
                <button class="element-btn el-undead" onclick="startElementQuiz('undead', this)">Undead</button>
                <button class="element-btn el-light"  onclick="startElementQuiz('light', this)">Light</button>
            </div>
            <div class="btn-row">
                <button class="element-btn el-dark"   onclick="startElementQuiz('dark', this)">Dark</button>
                <button class="element-btn el-kaos"   onclick="startElementQuiz('kaos', this)">Kaos</button>
            </div>
        </div>
        <button id="startElementBtn" onclick="startElementGame()">Start Game</button>
        <br>
        <button id="elementsBackBtn" onclick="backToHomeFromElements()">Back to Home</button>
    </div>

    <div id="quizScreen" class="hidden">
    <div class="quiz-topbar">
        <h2 id="quizTitle">Quiz</h2>
        <div class="stats">
            Score: <span id="score">0</span> / <span id="total">0</span> |
            <span id="timerLabel">Time Left</span>: <span id="timer">00:02:00</span>
        </div>
    </div>

    <div class="quiz-controls">
        <div class="input-wrap">
            <input type="text" id="guessInput" placeholder="Select a generation and press start..." disabled>
            <span id="shuffleGhost" class="hidden"></span>
        </div>
        <button id="typeShuffleBtn" onclick="toggleTypeShuffle()" disabled>Type-Shuffle</button>
        <button id="giveUpBtn" onclick="giveUp()" disabled>Give Up</button>
        <button id="restartBtn" onclick="startGame()">Restart</button>
        <div class="toggle-container">
            <span class="toggle-label">Stopwatch</span>
            <label class="switch">
                <input type="checkbox" id="timerToggle" checked>
                <span class="slider"></span>
            </label>
            <span class="toggle-label">Countdown</span>
        </div>
        <label class="toggle-label" for="timeInput">Time:</label>
        <input type="number" id="timeInput" value="120" min="1" style="width:70px;">
        <span class="toggle-label">min</span>
        <button id="pauseBtn" onclick="pauseGame()" disabled>Pause</button>
        <button id="backHomeBtn" onclick="backToHome()">Home</button>
    </div>

    <div class="found-list" id="foundList"></div>
    </div>

    <div id="pauseOverlay" class="hidden">
        <div class="pause-box">
            <h2>Paused</h2>
            <p>Save your progress or load an earlier game file.</p>
            <button onclick="resumeGame()">Resume</button>
            <button onclick="saveGame()">Save Game File</button>
            <button onclick="document.getElementById('loadFileInput').click()">Load Game File</button>
            <button onclick="quitFromPause()">Quit to Home</button>
            <input type="file" id="loadFileInput" accept=".json,application/json" style="display:none" onchange="loadGameFile(event)">
        </div>
    </div>
</div>

<div id="typeToast" class="hidden"></div>

<div id="winOverlay" class="win-overlay hidden">
    <div id="winText" class="win-text">PORTAL MASTER!</div>
</div>

<footer id="siteFootnote" class="hidden">
