    };

    const includeGroups = [
    "spyros_adventure",
    "giants",
    "swap_force",
    "trap_team",
    "superchargers",
    "imaginators"
];

skylandersData.gll = includeGroups.flatMap(
    group => skylandersData[group] || []
);

 function getSkylandersByElement(el) {
   const seen = new Map();
   Object.values(skylandersData).forEach(list => {
     list.forEach(s => {
       if (s.element === el && !seen.has(s.name)) seen.set(s.name, s);
     });
   });
   return [...seen.values()];
 }

    const generationDisplayNames = {
        gll: "All Skylanders",
        spyros_adventure: "Spyro's Adventure",
        giants: "Giants",
        swap_force: "Swap Force",
        trap_team: "Trap Team",
        superchargers: "SuperChargers",
        imaginators: "Imaginators",
        vehicles: "Vehicles",
        trap_villain: "Trappable Villains",
        earth: "Earth", air: "Air", fire: "Fire", water: "Water",
        magic: "Magic", tech: "Tech", life: "Life", undead: "Undead",
        light: "Light", dark: "Dark", kaos: "Kaos"
    };

console.log(skylandersData.gll);

    let currentGeneration = "gll"; 
    let activeRoster = skylandersData[currentGeneration];
    let guessedSkylanders = [];
    let timeLeft = 120;
    let gameTime = 120;
    let timerMode = "countdown";
    let elapsedTime = 0;
    let timerInterval;
    let gameActive = false;
    let gamePaused = false;

    const inputField = document.getElementById('guessInput');
    const scoreDisplay = document.getElementById('score');
    const totalDisplay = document.getElementById('total');
    const timerDisplay = document.getElementById('timer');
    const foundListDisplay = document.getElementById('foundList');
    const startBtn = document.getElementById('startBtn');
    const giveUpBtn = document.getElementById('giveUpBtn');
    const pauseBtn = document.getElementById('pauseBtn');

    totalDisplay.innerText = activeRoster.length;

    function normalize(text) {
        return text
            .toLowerCase()
            .replace(/[^a-z0-9]/g, "");
    }

    function toTitleCase(name) {
        return name
            .toLowerCase()
            .replace(/(^|[\s-])([a-z0-9])/g, (match, separator, char) => separator + char.toUpperCase());
    }



    function changeGeneration(genName, buttonElement) {
        clearInterval(timerInterval);
        gameActive = false;
        inputField.disabled = true;
        inputField.value = "";
        inputField.placeholder = "Select a generation and press start...";
        startBtn.innerText = "Start Game";
        giveUpBtn.disabled = true;
        pauseBtn.disabled = true;
        const activeBtn = document.querySelector('.filter-btn.active, .element-btn.active');
        if (activeBtn) activeBtn.classList.remove('playing');

        currentGeneration = genName;
        activeRoster = skylandersData[genName];
        
        totalDisplay.innerText = activeRoster.length;
        const titleEl = document.getElementById('quizTitle');
        if (titleEl) titleEl.innerText = generationDisplayNames[genName] || "Quiz";
        scoreDisplay.innerText = "0";
        buildBoard();
        timerDisplay.innerText = formatTime(gameTime * 60);
        timerMode = "countdown";
updateTimerLabel();


        const buttons = document.querySelectorAll('.filter-btn');
        buttons.forEach(btn => btn.classList.remove('active'));
        if (buttonElement) buttonElement.classList.add('active');
    }

    function showElementsScreen() {
        document.getElementById('homeScreen').classList.add('hidden');
        document.getElementById('elementsScreen').classList.remove('hidden');
    }

    function backToHomeFromElements() {
        document.getElementById('elementsScreen').classList.add('hidden');
        document.getElementById('homeScreen').classList.remove('hidden');
    }

    function getSkylandersByElement(el) {
        const seen = new Map();
        Object.values(skylandersData).forEach(list => {
            if (!Array.isArray(list)) return;
            list.forEach(s => {
                if (s && s.element === el && !seen.has(s.name)) {
                    seen.set(s.name, s);
                }
            });
        });
        return [...seen.values()];
    }

    const elementDisplayNames = {
        earth: "Earth", air: "Air", fire: "Fire", water: "Water",
        magic: "Magic", tech: "Tech", life: "Life", undead: "Undead",
        light: "Light", dark: "Dark", kaos: "Kaos"
    };

    let selectedElement = null;
    let selectedElementBtn = null;

    function startElementQuiz(elName, buttonElement) {
        if (selectedElementBtn === buttonElement) {
            buttonElement.classList.remove('active');
            selectedElement = null;
            selectedElementBtn = null;
            return;
        }
        document.querySelectorAll('.element-btn.active').forEach(btn => {
            btn.classList.remove('active', 'playing');
        });
        buttonElement.classList.add('active');
        selectedElement = elName;
        selectedElementBtn = buttonElement;
    }

    function startElementGame() {
        if (!selectedElement || !selectedElementBtn) {
            showTypeToast("Please select an element first.");
            return;
        }
        clearInterval(timerInterval);
        gameActive = false;
        inputField.disabled = true;
        inputField.value = "";
        inputField.placeholder = "Press start to begin...";
        startBtn.innerText = "Start Game";
        giveUpBtn.disabled = true;

        document.querySelectorAll('.filter-btn.active').forEach(btn => {
            btn.classList.remove('active', 'playing');
        });

        currentGeneration = selectedElement;
        activeRoster = getSkylandersByElement(selectedElement);
        totalDisplay.innerText = activeRoster.length;

        const titleEl = document.getElementById('quizTitle');
        if (titleEl) titleEl.innerText = "Element: " + (elementDisplayNames[selectedElement] || selectedElement);

        scoreDisplay.innerText = "0";
        buildBoard();
        timerDisplay.innerText = formatTime(gameTime * 60);
        timerMode = "countdown";
        updateTimerLabel();

        document.getElementById('elementsScreen').classList.add('hidden');
        startGame();
    }

    function updateTimerLabel() {
        const label = document.getElementById('timerLabel');
        const toggle = document.getElementById('timerToggle');

        if (label && toggle) {
            label.innerText = toggle.checked ? 'Time Left' : 'Time Spent';
        }
    }
    
    function formatTime(seconds) {
    let hrs = Math.floor(seconds / 3600);
    let mins = Math.floor((seconds % 3600) / 60);
    let secs = seconds % 60;

    return (
        String(hrs).padStart(2, "0") + ":" +
        String(mins).padStart(2, "0") + ":" +
        String(secs).padStart(2, "0")
    );
    }

function startGame() {
    clearInterval(timerInterval);
    guessedSkylanders = [];

    document.getElementById('homeScreen').classList.add('hidden');
    document.getElementById('quizScreen').classList.remove('hidden');
    document.getElementById('siteFootnote').classList.remove('hidden');

    const isCountdown = document.getElementById("timerToggle").checked;
    timerMode = isCountdown ? "countdown" : "stopwatch";
    updateTimerLabel();

    gameTime = parseInt(document.getElementById("timeInput").value);
    if (isNaN(gameTime) || gameTime < 1) gameTime = 2;
    timeLeft = gameTime * 60;

    gameActive = true;
    buildBoard();
    scoreDisplay.innerText = "0";

    inputField.disabled = false;
    inputField.value = "";
    inputField.placeholder = "Type a Skylander name...";
    inputField.focus();

    startBtn.innerText = "Restart";
    giveUpBtn.disabled = false;
    setTypeShuffle(false);
    refreshShuffleButton();
    document.querySelector('.filter-btn.active, .element-btn.active')?.classList.add('playing');

    pauseBtn.disabled = false;
    gamePaused = false;
    document.getElementById('pauseOverlay').classList.add('hidden');

    if (timerMode === "stopwatch") elapsedTime = 0;
    runTimer();
}

function runTimer() {
    clearInterval(timerInterval);
    if (timerMode === "countdown") {
        timerDisplay.innerText = formatTime(timeLeft);
        timerInterval = setInterval(() => {
            timeLeft--;
            timerDisplay.innerText = formatTime(timeLeft);
            if (timeLeft <= 0) endGame(false);
        }, 1000);
    } else {
        timerDisplay.innerText = formatTime(elapsedTime);
        timerInterval = setInterval(() => {
            elapsedTime++;
            timerDisplay.innerText = formatTime(elapsedTime);
        }, 1000);
    }
}

function pauseGame() {
    if (!gameActive || gamePaused) return;
    gamePaused = true;
    clearInterval(timerInterval);
    inputField.disabled = true;
    document.getElementById('pauseOverlay').classList.remove('hidden');
}

function resumeGame() {
    if (!gamePaused) return;
    gamePaused = false;
    document.getElementById('pauseOverlay').classList.add('hidden');
    if (gameActive) {
        inputField.disabled = false;
        inputField.focus();
        runTimer();
    }
}

function quitFromPause() {
    gamePaused = false;
    document.getElementById('pauseOverlay').classList.add('hidden');
    backToHome();
}

function saveGame() {
    const data = {
        version: 1,
        savedAt: new Date().toISOString(),
        currentGeneration,
        rosterNames: activeRoster.map(s => s.name),
        quizTitle: document.getElementById('quizTitle').innerText,
        guessedSkylanders,
        timerMode,
        timeLeft,
        elapsedTime,
        gameTime
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `skylanders-quiz-${currentGeneration}-${Date.now()}.json`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
}

function loadGameFile(event) {
    const file = event.target.files && event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
        try {
            applySave(JSON.parse(reader.result));
        } catch (e) {
            showTypeToast("That file could not be read as a Skylanders Quiz save.");
        }
    };
    reader.readAsText(file);
    event.target.value = "";
}

function applySave(data) {
    if (!data || !Array.isArray(data.rosterNames)) {
        showTypeToast("That save file is missing quiz data.");
        return;
    }
    clearInterval(timerInterval);
    
    const byName = new Map();
    Object.values(skylandersData).forEach(list => {
        if (!Array.isArray(list)) return;
        list.forEach(s => { if (s && !byName.has(s.name)) byName.set(s.name, s); });
    });
    activeRoster = data.rosterNames.map(n => byName.get(n) || { name: n });

    currentGeneration = data.currentGeneration || currentGeneration;
    guessedSkylanders = Array.isArray(data.guessedSkylanders) ? data.guessedSkylanders.slice() : [];
    timerMode = data.timerMode === "stopwatch" ? "stopwatch" : "countdown";
    gameTime = data.gameTime || gameTime;
    timeLeft = typeof data.timeLeft === "number" ? data.timeLeft : gameTime * 60;
    elapsedTime = typeof data.elapsedTime === "number" ? data.elapsedTime : 0;

    document.getElementById('timerToggle').checked = (timerMode === "countdown");
    document.getElementById('timeInput').value = gameTime;
    updateTimerLabel();

    document.getElementById('homeScreen').classList.add('hidden');
    document.getElementById('elementsScreen').classList.add('hidden');
    document.getElementById('quizScreen').classList.remove('hidden');
    document.getElementById('siteFootnote').classList.remove('hidden');
    const titleEl = document.getElementById('quizTitle');
    if (titleEl && data.quizTitle) titleEl.innerText = data.quizTitle;

    totalDisplay.innerText = activeRoster.length;
    buildBoard();
    guessedSkylanders.forEach(key => flipCard(key, false));
    scoreDisplay.innerText = guessedSkylanders.length;

    gameActive = true;
    gamePaused = false;
    startBtn.innerText = "Restart";
    giveUpBtn.disabled = false;
    pauseBtn.disabled = false;
    inputField.disabled = false;
    inputField.value = "";
    inputField.placeholder = "Type a Skylander name...";
    setTypeShuffle(false);
    refreshShuffleButton();
    timerDisplay.innerText = formatTime(timerMode === "countdown" ? timeLeft : elapsedTime);
    document.getElementById('pauseOverlay').classList.add('hidden');
    inputField.focus();
    runTimer();
}

function backToHome() {
    clearInterval(timerInterval);
    gameActive = false;
    guessedSkylanders = [];
    inputField.disabled = true;
    inputField.value = "";
    giveUpBtn.disabled = true;
    pauseBtn.disabled = true;
    setTypeShuffle(false);
    refreshShuffleButton();
    gamePaused = false;
    document.getElementById('pauseOverlay').classList.add('hidden');
    foundListDisplay.innerHTML = "";
    scoreDisplay.innerText = "0";
    const activeBtn = document.querySelector('.filter-btn.active, .element-btn.active');
    if (activeBtn) activeBtn.classList.remove('playing');
    startBtn.innerText = "Start Game";
    document.getElementById('quizScreen').classList.add('hidden');
    document.getElementById('homeScreen').classList.remove('hidden');
    document.getElementById('siteFootnote').classList.add('hidden');
    window.scrollTo(0, 0);
}

    inputField.addEventListener('input', () => {
        if (!gameActive || gamePaused) return;

        updateShuffleGhost();

        const processedInput = normalize(inputField.value);
        if (!processedInput) return;

        const match = activeRoster.find(s => normalize(s.name) === processedInput);
        if (!match) return;

        const processedName = normalize(match.name);
        if (guessedSkylanders.includes(processedName)) return;

        if (shuffleOn && shuffleElement && getItemElement(match) !== shuffleElement) {
            showTypeToast(toTitleCase(match.name) + " is not " + shuffleElementName());
            return;
        }

        guessedSkylanders.push(processedName);
        flipCard(processedName, false);
        scoreDisplay.innerText = guessedSkylanders.length;

        if (processedName === normalize("kaos") && currentGeneration !== "kaos") {
            showTypeToast("It is I, KAOOOOOOOS!");
        }
        if (match.quote) showTypeToast(match.quote);

        inputField.value = "";
        updateShuffleGhost();

        if (guessedSkylanders.length === activeRoster.length) {
            endGame(true);
            return;
        }

        if (shuffleOn) pickShuffleElement();
    });

    function giveUp() {
        endGame(false);
    }

function endGame(isWin) {
    clearInterval(timerInterval);
    gameActive = false;
    inputField.disabled = true;
    giveUpBtn.disabled = true;
    pauseBtn.disabled = true;
    setTypeShuffle(false);
    refreshShuffleButton();
    gamePaused = false;
    document.getElementById('pauseOverlay').classList.add('hidden');

    const activeBtn = document.querySelector('.filter-btn.active, .element-btn.active');
    if (activeBtn) activeBtn.classList.remove('playing');

    if (isWin) {
        const overlay = document.getElementById("winOverlay");
        const winText = document.getElementById("winText");
        const isKaos = currentGeneration === "kaos";
        winText.textContent = isKaos ? "POSER MASTER!" : "PORTAL MASTER!";
        overlay.classList.remove("hidden");

        // auto-hide after animation
        setTimeout(() => {
            overlay.classList.add("hidden");
            showTypeToast(isKaos
                ? "Behold! It is I, KAOS! And as you can see, I AM AWESOME!"
                : "Amazing Portal Master! You named them all!");
        }, 2500);

    } else {
        showTypeToast(`Game Over! You found ${guessedSkylanders.length} Skylanders.`);
        revealMissed();
    }
}

    function computeCardSize(count) {
        // Largest card width (with 3/4 aspect ratio) that fits the visible
        // grid area without scrolling. Capped at 200px (4x the All
        // Skylanders quiz size).
        const W = foundListDisplay.clientWidth - 12;  // padding
        const H = foundListDisplay.clientHeight - 12;
        const gap = 6;
        let size = 200;
        while (size > 20) {
            const cols = Math.max(1, Math.floor((W + gap) / (size + gap)));
            const rows = Math.ceil(count / cols);
            if (rows * (size * 4 / 3) + (rows - 1) * gap <= H) break;
            size -= 2;
        }
        return { size, gap, font: Math.max(7, Math.round(size * 0.14)) };
    }

    function setBoardScale(count) {
        const { size, gap, font } = computeCardSize(count);
        foundListDisplay.style.setProperty('--card-size', size + 'px');
        foundListDisplay.style.setProperty('--card-gap', gap + 'px');
        foundListDisplay.style.setProperty('--card-font', font + 'px');
    }

    window.addEventListener('resize', () => {
        if (activeRoster && activeRoster.length) setBoardScale(activeRoster.length);
    });

    function buildBoard() {
        foundListDisplay.innerHTML = "";
        setBoardScale(activeRoster.length);
        activeRoster.forEach(skylander => {
            const processedName = normalize(skylander.name);
            const imgSrc = skylander.image || `https://placehold.co/100x100?text=${encodeURIComponent(skylander.name)}`;
            const card = document.createElement('div');
            card.className = 'skylander-card';
            card.dataset.key = processedName;
            card.innerHTML = `
                <div class="card-inner">
                    <div class="card-face card-front">?</div>
                    <div class="card-face card-back">
                        <img src="${imgSrc}" alt="${skylander.name}" loading="lazy">
                        <span>${toTitleCase(skylander.name)}</span>
                    </div>
                </div>
            `;
            foundListDisplay.appendChild(card);
        });
    }

    function flipCard(key, missed) {
        const card = foundListDisplay.querySelector(`.skylander-card[data-key="${key}"]`);
        if (!card) return;
        if (missed) card.classList.add('missed');
        card.classList.add('flipped');
    }

    function revealMissed() {
        activeRoster.forEach(skylander => {
            const processedName = normalize(skylander.name);
            if (!guessedSkylanders.includes(processedName)) {
                flipCard(processedName, true);
            }
        });
    }

const ELEMENT_KEYS = ["earth","air","fire","water","magic","tech","life","undead","light","dark","kaos"];
const elementColorMap = {
    earth:  { bg: "#b1701f", border: "#975907" },
    air:    { bg: "#3fbaf7", border: "#25a0f2" },
    fire:   { bg: "#e61a1d", border: "#cc0101" },
    water:  { bg: "#1b4c8d", border: "#023576" },
    magic:  { bg: "#6f418a", border: "#592972" },
    tech:   { bg: "#f5812b", border: "#e66b15" },
    life:   { bg: "#18b125", border: "#01980c" },
    undead: { bg: "#65636f", border: "#4e4c58" },
    light:  { bg: "#fce14f", border: "#fac936" },
    dark:   { bg: "#243d5c", border: "#0d2345" },
    kaos:   { bg: "#493e71", border: "#31275a" }
};
const DEFAULT_BG = "#0097d5";
const STANDARD_ELEMENTS = ["earth","air","fire","water","magic","tech","life","undead","light","dark"];
const STANDARD_BG_COLORS = STANDARD_ELEMENTS.map(k => elementColorMap[k].bg);

let shuffleOn = false;
let shuffleElement = null;
let typeToastTimer = null;
let rainbowTimer = null;
let rainbowIndex = 0;

const shuffleBtn = document.getElementById('typeShuffleBtn');
const shuffleGhost = document.getElementById('shuffleGhost');
const typeToast = document.getElementById('typeToast');
const quizContainer = document.querySelector('.container');

function getItemElement(item) {
    return (item && (item.element || item.ftyp)) || null;
}

function isElementQuiz() {
    return ELEMENT_KEYS.includes(currentGeneration);
}

function remainingElements() {
    const set = new Set();
    activeRoster.forEach(s => {
        if (guessedSkylanders.includes(normalize(s.name))) return;
        const el = getItemElement(s);
        if (el && (elementColorMap[el] || currentGeneration === 'custom')) set.add(el);
    });
    return [...set];
}

function pickShuffleElement() {
    const options = remainingElements();
    if (!options.length) {
        setTypeShuffle(false);
        return;
    }
    shuffleElement = options[Math.floor(Math.random() * options.length)];
    applyShuffleVisuals();
}

function stopRainbow() {
    if (rainbowTimer) { clearInterval(rainbowTimer); rainbowTimer = null; }
}

function startRainbow() {
    if (rainbowTimer || !quizContainer) return;
    rainbowIndex = 0;
    quizContainer.style.background = STANDARD_BG_COLORS[0];
    rainbowTimer = setInterval(() => {
        rainbowIndex = (rainbowIndex + 1) % STANDARD_BG_COLORS.length;
        quizContainer.style.background = STANDARD_BG_COLORS[rainbowIndex];
    }, 2000);
}

function shuffleElementName() {
    return elementDisplayNames[shuffleElement] || toTitleCase(shuffleElement);
}

function applyShuffleVisuals() {
    const colors = shuffleOn && shuffleElement ? elementColorMap[shuffleElement] : null;
    if (quizContainer) {
        if (colors) {
            stopRainbow();
            quizContainer.style.background = colors.bg;
        } else if (shuffleOn && shuffleElement) {
            // custom element with no fixed color: slowly cycle through all 10 element colors
            startRainbow();
        } else {
            stopRainbow();
            quizContainer.style.background = DEFAULT_BG;
        }
    }
    if (foundListDisplay) {
        foundListDisplay.style.border = colors ? ("3px solid " + colors.border) : "none";
    }
    updateShuffleGhost();
}

function updateShuffleGhost() {
    if (!shuffleGhost) return;
    const empty = inputField.value.trim() === "";
    if (shuffleOn && shuffleElement && empty) {
        shuffleGhost.textContent = shuffleElementName();
        shuffleGhost.classList.remove('hidden');
    } else {
        shuffleGhost.classList.add('hidden');
    }
}

function setTypeShuffle(on) {
    shuffleOn = on && !isElementQuiz();
    if (shuffleOn) {
        shuffleBtn.classList.add('on');
        pickShuffleElement();
        if (!shuffleOn) return;
    } else {
        shuffleElement = null;
        shuffleBtn.classList.remove('on');
        applyShuffleVisuals();
    }
}

function toggleTypeShuffle() {
    if (!gameActive || gamePaused || isElementQuiz()) return;
    setTypeShuffle(!shuffleOn);
    inputField.focus();
}

function refreshShuffleButton() {
    if (!shuffleBtn) return;
    const available = !isElementQuiz();
    shuffleBtn.style.display = available ? "" : "none";
    shuffleBtn.disabled = !available || !gameActive;
}

function showTypeToast(message) {
    if (!typeToast) return;
    typeToast.textContent = message;
    typeToast.classList.remove('hidden');
    clearTimeout(typeToastTimer);
    const ms = Math.min(4000, Math.max(2000, message.length * 55));
    typeToastTimer = setTimeout(() => typeToast.classList.add('hidden'), ms);
}

const elementColors = [
    { bg: "#b1701f", border: "#975907" }, // Earth
    { bg: "#3fbaf7", border: "#25a0f2" }, // Air
    { bg: "#e61a1d", border: "#cc0101" }, // Fire
    { bg: "#1b4c8d", border: "#023576" }, // Water
    { bg: "#6f418a", border: "#592972" }, // Magic
    { bg: "#f5812b", border: "#e66b15" }, // Tech
    { bg: "#18b125", border: "#01980c" }, // Life
    { bg: "#65636f", border: "#4e4c58" }, // Undead
    { bg: "#fce14f", border: "#fac936" }, // Light
    { bg: "#243d5c", border: "#0d2345" }, // Dark
    { bg: "#493e71", border: "#31275a" }  // Kaos
];

const elementsBtn = document.getElementById("elementsBtn");
let colorIndex = 0;

function updateButtonColor() {
    elementsBtn.style.backgroundColor = elementColors[colorIndex].bg;
    elementsBtn.style.borderColor = elementColors[colorIndex].border;

    colorIndex = (colorIndex + 1) % elementColors.length;
}

updateButtonColor();

setInterval(updateButtonColor, 2000);
</script>


<script>
function builderCardHtml() {
    return '<button class="remove" title="Remove" onclick="this.parentElement.remove()">&times;</button>' +
        '<label>Name</label><input class="b-name" type="text" placeholder="name">' +
        '<label>Element</label><input class="b-element" type="text" placeholder="element (optional)">' +
        '<label>Image address</label><input class="b-image" type="text" placeholder="https://... (optional)">' +
        '<div class="preview"></div>' +
        '<label>Quote</label><input class="b-quote" type="text" placeholder="pop-up quote (optional)">';
}
function addBuilderCard(item) {
    const grid = document.getElementById('builderGrid');
    const card = document.createElement('div');
    card.className = 'builder-card';
    card.innerHTML = builderCardHtml();
    const img = card.querySelector('.b-image'), prev = card.querySelector('.preview');
    img.addEventListener('input', () => {
        prev.innerHTML = '';
        if (img.value.trim()) { const i = document.createElement('img'); i.src = img.value.trim(); i.onerror = () => i.remove(); prev.appendChild(i); }
    });
    if (item && typeof item.name === 'string') {
        card.querySelector('.b-name').value = item.name || '';
        card.querySelector('.b-element').value = item.element || item.ftyp || '';
        img.value = item.image || '';
        card.querySelector('.b-quote').value = item.quote || (item.name.toLowerCase() === 'kaos' ? 'It is I, KAOOOOOOOS!' : '');
        img.dispatchEvent(new Event('input'));
    }
    grid.insertBefore(card, document.getElementById('addCircle'));
}
function builderQuizOptions() {
    const groups = ['gll', 'spyros_adventure', 'giants', 'swap_force', 'trap_team', 'superchargers', 'imaginators', 'vehicles', 'trap_villain'];
    const options = groups.map(key => ({ title: generationDisplayNames[key], items: skylandersData[key] || [] }));
    const builtInItems = groups.filter(key => key !== 'gll').flatMap(key => skylandersData[key] || []);
    ['earth', 'air', 'fire', 'water', 'magic', 'tech', 'life', 'undead', 'light', 'dark', 'kaos'].forEach(element => {
        options.push({ title: generationDisplayNames[element], items: builtInItems.filter(item => (item.element || item.ftyp) === element) });
    });
    if (skylandersData.custom) options.push({ title: generationDisplayNames.custom, items: skylandersData.custom });
    return options;
}
function toggleBuilderQuizChoices() {
    const choices = document.getElementById('builderQuizChoices');
    const opening = choices.classList.contains('hidden');
    choices.replaceChildren();
    if (opening) builderQuizOptions().forEach(option => {
        const button = document.createElement('button');
        button.textContent = option.title;
        button.onclick = () => importQuizIntoBuilder(option);
        choices.appendChild(button);
    });
    choices.classList.toggle('hidden', !opening);
    document.getElementById('addQuizBtn').setAttribute('aria-expanded', String(opening));
}
function importQuizIntoBuilder(option) {
    const cards = [...document.querySelectorAll('.builder-card')];
    const seen = new Set(cards.map(card => card.querySelector('.b-name').value.trim().toLowerCase()).filter(Boolean));
    let added = 0;
    option.items.forEach(item => {
        const name = item.name.trim().toLowerCase();
        if (!name || seen.has(name)) return;
        seen.add(name);
        addBuilderCard(item);
        added++;
    });
    if (added) cards.forEach(card => {
        if ([...card.querySelectorAll('input')].every(input => !input.value.trim())) card.remove();
    });
    document.getElementById('builderImportStatus').textContent = added ? `${option.title}: ${added} added` : 'These names are already in your quiz.';
    document.getElementById('builderQuizChoices').classList.add('hidden');
    document.getElementById('addQuizBtn').setAttribute('aria-expanded', 'false');
}
function openBuilder() {
    const grid = document.getElementById('builderGrid');
    if (!grid.children.length) {
        const plus = document.createElement('button');
        plus.id = 'addCircle'; plus.className = 'add-circle'; plus.textContent = '+'; plus.title = 'Add';
        plus.onclick = addBuilderCard;
        grid.appendChild(plus);
        for (let i = 0; i < 3; i++) addBuilderCard();
    }
    document.getElementById('homeScreen').classList.add('hidden');
    document.getElementById('builderScreen').classList.remove('hidden');
}
function closeBuilder() {
    document.getElementById('builderScreen').classList.add('hidden');
    document.getElementById('homeScreen').classList.remove('hidden');
}
function downloadCustomQuiz() {
    const items = [...document.querySelectorAll('.builder-card')].map(c => ({
        name: c.querySelector('.b-name').value.trim(),
        element: c.querySelector('.b-element').value.trim().toLowerCase(),
        image: c.querySelector('.b-image').value.trim(),
        quote: c.querySelector('.b-quote').value.trim()
    })).filter(i => i.name);
    if (!items.length) { showTypeToast("Add at least one name first."); return; }
    const title = document.getElementById('builderTitle').value.trim() || "Custom Quiz";
    const blob = new Blob([JSON.stringify({ type: "custom-quiz", title, items }, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = title.replace(/[^a-z0-9]+/gi, '_') + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 30000);
}
function loadCustomQuiz(event) {
    const file = event.target.files[0];
    event.target.value = '';
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
        let data;
        try { data = JSON.parse(reader.result); } catch (e) { showTypeToast("That file is not a valid quiz."); return; }
        const items = Array.isArray(data.items) ? data.items.filter(i => i && i.name) : [];
        if (!items.length) { showTypeToast("That quiz has no names in it."); return; }
        skylandersData.custom = items.map(i => ({ name: String(i.name).toLowerCase(), element: String(i.element || "").toLowerCase().trim(), image: i.image || "", quote: i.quote || "" }));
        generationDisplayNames.custom = data.title || "Custom Quiz";
        changeGeneration('custom', null);
        startGame();
        inputField.placeholder = "Type a name...";
    };
    reader.readAsText(file);
}
</script>
</body>
</html>
